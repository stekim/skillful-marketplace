# Local dev (PostgreSQL via Homebrew)
DATABASE_URL=postgresql+psycopg://stevekim@localhost:5432/skillful_marketplace

# Vercel + Neon (production):
#   1) Create a Neon project at https://console.neon.tech (free tier is fine)
#   2) Copy the *pooled* connection string (uses PgBouncer, friendlier for
#      serverless). Replace the leading `postgresql://` with
#      `postgresql+psycopg://` so SQLAlchemy uses psycopg3.
#   Example shape:
# DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/skillful_marketplace?sslmode=require

JWT_SECRET=dev-change-me-supersecret
JWT_ALGORITHM=HS256

# Comma-separated list of allowed browser origins. Include every Vercel
# domain that needs to call the API: your production domain, the *-git-main-*
# alias, and (if you want preview deploys to work) the per-deploy alias.
CORS_ORIGINS=http://localhost:3000,https://skillful-marketplace-six.vercel.app
